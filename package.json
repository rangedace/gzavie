{
  "name": "gzavie-discord-music-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord music bot focused on YouTube playback, Docker packaging and GitLab CI.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
